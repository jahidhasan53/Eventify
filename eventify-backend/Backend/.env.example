# ---- Application ----------------------------------------------------------
APP_NAME=Eventify
# development | production   (the test-suite sets "testing" itself)
ENVIRONMENT=development

# ---- Database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eventify
# Used ONLY by the pytest suite. The database name MUST end in "_test".
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eventify_test

# ---- Auth / tokens --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be >= 32 characters; the app refuses to start with this placeholder.
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
# Optional separate key for signing QR ticket tokens (derived from JWT_SECRET_KEY if empty)
TICKET_HMAC_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# ---- CORS / cookies -------------------------------------------------------
# Comma-separated allow-list. Wildcards are rejected.
FRONTEND_ORIGIN=http://localhost:5173
# Where the password-reset e-mail link points (defaults to first FRONTEND_ORIGIN + /reset-password)
FRONTEND_RESET_URL=
# Leave empty: secure cookies are enabled automatically in production.
COOKIE_SECURE=
# lax | strict | none   (use "none" only when frontend and API are on different sites; requires HTTPS)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---- Limits ---------------------------------------------------------------
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SENSITIVE_PER_MINUTE=5
RATE_LIMIT_GLOBAL_PER_MINUTE=300
# Set true ONLY when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# ---- E-mail ---------------------------------------------------------------
# console (development: logs messages) | smtp | disabled
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
EMAIL_FROM=Eventify <no-reply@example.com>

# ---- Background jobs ------------------------------------------------------
# Marks ended events as completed and sends 24h reminders
ENABLE_BACKGROUND_JOBS=true
